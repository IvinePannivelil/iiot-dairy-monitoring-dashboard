# InfluxDB 2.x first-boot initialisation
# Sourced by the influxdb container via env_file in docker-compose.yml.
# Values here MUST match INFLUX_TOKEN / INFLUX_ORG in the root .env.

DOCKER_INFLUXDB_INIT_MODE=setup
DOCKER_INFLUXDB_INIT_USERNAME=admin
DOCKER_INFLUXDB_INIT_PASSWORD=dairyadmin2024
DOCKER_INFLUXDB_INIT_ORG=PLANT_A
DOCKER_INFLUXDB_INIT_BUCKET=plc_tags
DOCKER_INFLUXDB_INIT_RETENTION=30d
DOCKER_INFLUXDB_INIT_ADMIN_TOKEN=dairy-influx-token-changeme