            ]
        ]
    },
    {
        "id": "s7-in-rec",
        "type": "s7 in",
        "z": "tab-main",
        "endpoint": "s7-endpoint-rec",
        "mode": "all",
        "variable": "",
        "diff": false,
        "name": "Live Telemetry (Reception)",
        "x": 340,
        "y": 80,
        "wires": [
            [
                "fn-fmt-rec"
            ]
        ]
    },
    {
        "id": "fn-fmt-rec",
        "type": "function",
        "z": "tab-main",
        "name": "Format Reception",
        "func": "const d = msg.payload;\nif (!d) return null;\n\n// Map Node-RED variable name → InfluxDB field name (kept 1:1 for clarity)\nconst fieldMap = {\n  'TT1':           'TT1',\n  'TT2':           'TT2',\n  'TT3':           'TT3',\n  'TT4':           'TT4',\n  'TT5':           'TT5',\n  'TT6':           'TT6',\n  'TT7':           'TT7',\n  'FM1':           'FM1',\n  'FM2':           'FM2',\n  'TOT_RECEPTION': 'TOT_RECEPTION',\n  'TOT_WATER_FLUSH':'TOT_WATER_FLUSH',\n  'VFD1_SP':       'VFD1_SP',\n  'VFD2_SP':       'VFD2_SP',\n  'VFD1_HZ':       'VFD1_HZ',\n  'VFD2_HZ':       'VFD2_HZ',\n  'RECEP_FLOW_SP': 'RECEP_FLOW_SP',\n  'RMST_OUT_SP':   'RMST_OUT_SP',\n  'RCM_HIGH':      'RCM_HIGH',\n  'RCM_LOW':       'RCM_LOW',\n  'RMST_HIGH':     'RMST_HIGH',\n  'RMST_LOW':      'RMST_LOW',\n  'unloadTankRCM':  'unloadTankRCM',\n  'unloadTankRMST': 'unloadTankRMST',\n  'destRcmTank':    'destRcmTank',\n  'destRmstTank':   'destRmstTank'\n};\n\n// Derived aliases: RCM_TEMP = TT4, RMST_TEMP = TT5 (same physical address)\nconst derived = {\n  'RCM_TEMP':  d['TT4'],\n  'RMST_TEMP': d['TT5']\n};\n\nconst points = [];\n\nfor (const [name, influxField] of Object.entries(fieldMap)) {\n  const val = d[name];\n  if (val !== undefined && val !== null) {\n    points.push({\n      measurement: 'machine_data',\n      tags:   { system: 'reception' },\n      fields: { [influxField]: typeof val === 'boolean' ? (val ? 1 : 0) : parseFloat(val) }\n    });\n  }\n}\n\nfor (const [influxField, val] of Object.entries(derived)) {\n  if (val !== undefined && val !== null) {\n    points.push({\n      measurement: 'machine_data',\n      tags:   { system: 'reception' },\n      fields: { [influxField]: parseFloat(val) }\n    });\n  }\n}\n\nmsg.payload = points;\nreturn msg;",
        "outputs": 1,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
        "libs": [],
        "x": 570,
        "y": 80,
        "wires": [
            [
                "influx-out-main"
            ]
        ]
    },
    {
        "id": "influx-out-main",
        "type": "influxdb out",
        "z": "tab-main",
        "influxdb": "influx-config",
        "name": "Write to InfluxDB",
        "measurement": "plc_tags",
        "precision": "s",
        "retentionPolicy": "",
        "database": "plc_data",
        "precisionV18FluxV20": "s",
        "retentionPolicyV18Flux": "",
        "org": "PLANT_A",
        "bucket": "plc_data",
        "x": 800,
        "y": 140,
        "wires": []
    }
]