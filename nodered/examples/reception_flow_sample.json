        "vartable": [
            { "addr": "DB3,REAL406",  "name": "TT1" },
            { "addr": "DB3,REAL428",  "name": "TT2" },
            { "addr": "DB3,REAL450",  "name": "TT3" },
            { "addr": "DB3,REAL472",  "name": "TT4" },
            { "addr": "DB3,REAL494",  "name": "TT5" },
            { "addr": "DB3,REAL516",  "name": "TT6" },
            { "addr": "DB3,REAL620",  "name": "TT7" },
            { "addr": "DB9,REAL48",   "name": "FM1" },
            { "addr": "DB9,REAL52",   "name": "FM2" },
            { "addr": "DB3,REAL594",  "name": "TOT_RECEPTION" },
            { "addr": "DB3,REAL274",  "name": "TOT_WATER_FLUSH" },
            { "addr": "DB3,REAL140",  "name": "VFD1_SP" },
            { "addr": "DB3,REAL362",  "name": "VFD2_SP" },
            { "addr": "DB14,REAL66",  "name": "VFD1_HZ" },
            { "addr": "DB14,REAL70",  "name": "VFD2_HZ" },
            { "addr": "DB3,REAL18",   "name": "RECEP_FLOW_SP" },
            { "addr": "DB3,REAL22",   "name": "RMST_OUT_SP" },
            { "addr": "DB1,X0.6",     "name": "RCM_HIGH" },
            { "addr": "DB1,X0.7",     "name": "RCM_LOW" },
            { "addr": "DB1,X1.0",     "name": "RMST_HIGH" },
