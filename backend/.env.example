# ──────────────────────────────────────────────────────────────
#  IIoT Dairy Monitoring — Python FastAPI Backend
#  Environment Configuration Template
#  Copy to .env and fill in real values before running.
# ──────────────────────────────────────────────────────────────

# --- Server ---
PORT=5000

# --- InfluxDB ---
INFLUX_URL=http://localhost:8086
INFLUX_TOKEN=your-influxdb-token-here
INFLUX_ORG=plant_a
INFLUX_BUCKET=plc_data

# --- Node-RED ---
# The Node-RED HTTP endpoint that exposes a snapshot of live tag values
# Node-RED should have an http-in node at /plc/snapshot returning JSON
NODERED_URL=http://localhost:1880
NODERED_SNAPSHOT_PATH=/plc/snapshot

# --- Prediction Worker ---
PREDICTION_INTERVAL_SEC=10
PREDICTION_LOOKBACK_SEC=60
